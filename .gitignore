# dependencies (bun install)
node_modules

# output
out
dist
*.tgz

# `bun build --compile` writes per-target stub files at the repo root
# (~63 MB each). Phase 2 build artifacts ship via `dist/` and GitHub
# Releases, never via the working tree.
.*.bun-build

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# Real-device fixtures contain secrets (PINs, passwords, device IDs,
# phone numbers). Never commit. Use tests/fixtures/kindle/redacted/*
# for anything that needs to live in the repo.
tests/fixtures/kindle/*.lua
!tests/fixtures/kindle/redacted/
!tests/fixtures/kindle/redacted/**

# Safe-write backups (from running kindly against anything)
.kindly/

# Snapshot archives — contain plaintext secrets (settings.reader.lua,
# history.lua, device_id, etc.). Never commit.
*.tar.gz

# Local probe artifacts at repo root (from running `kindly pull` against
# a real device). May contain device data. The user-facing kindly.yaml
# lives wherever the user runs the CLI — not in the repo root.
/kindly.yaml
