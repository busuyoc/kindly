# Real-device fixtures contain secrets (PINs, passwords, device IDs,
# phone numbers). Never commit. Use tests/fixtures/kindle/redacted/*
# for anything that needs to live in the repo.
tests/fixtures/kindle/*.lua
!tests/fixtures/kindle/redacted/
!tests/fixtures/kindle/redacted/**

# Safe-write backups (from running kindly against anything)
.kindly/

# Snapshot archives — contain plaintext secrets (settings.reader.lua,
# history.lua, device_id, etc.). Never commit.
*.tar.gz
